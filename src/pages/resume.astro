---
import '/src/styles/global.css'
import "paper-css/paper.min.css";
import "bootstrap-icons/font/bootstrap-icons.css";


let model: Props = {
    Name: "Karl Oskar Anderson",
    Title: "Fullstack developer",
    IntroText: `
        Fullstack developer with over 3 years of experience building mainly React and Vue frontends backed by PHP and Python.
        At Estravel that means integrating provider APIs into customer booking platforms and building internal offer composition tooling.
    `,
    SideInfo: [
        {
            Svg: "bi bi-geo-alt-fill",
            Text: "Tallinn",
            Link: null
        },
        {
            Svg: "bi bi-telephone-fill",
            Text: "+372 5141103",
            Link: null
        },
        {
            Svg: "bi bi-envelope-fill",
            Text: "andersonkarloskar@gmail.com",
            Link: null
        },
        {
            Svg: "bi bi-house-door-fill",
            Text: "https://oskar-anderson.com",
            Link: "https://oskar-anderson.com/"
        }
    

    ],
    CategorizedListSections: {
        Heading: {
            Title: "Skills"
        },
        Content: [
            {
                CategoryName: "Frontend",
                List: ["React", "Vue", "JavaScript", "TypeScript", "Tailwind", "HTML/CSS"],
            },
            {
                CategoryName: "Backend",
                List: ["PHP", "Python", "FastAPI", "Laravel", "WordPress", "RabbitMQ", "REST", "SQL (MySQL/MariaDB)"]
            },
            {
                CategoryName: "Tools",
                List: ["Git (GitHub, GitLab)", "Docker", "WSL", "Postman", "Swagger"]
            },
            {
                CategoryName: "Other",
                List: ["Native Estonian", "Proficient English", "B and C level driving"]
            }
        ],
    },
    WorkSection: {
        Heading: {
            Title: "Work"
        },
        Content: [
            {
                Title: "Fullstack developer",
                Company: "Estravel",
                Period: "June 2026 - present",
                Bullets: [
                    "Developing a fullstack offer composition workspace that transforms partner portal data into client-ready Estravel-branded offer/confirmation email copy via AI",
                ],
                Technologies: "Python, FastAPI, RabbitMQ/Celery, React, PHP, MySQL",
                Link: {
                    Src: "https://oskar-anderson.com/posts/estravel-metasearch",
                    Text: "[read more]"
                }
            },
            {
                Title: "Web developer",
                Company: "Estravel",
                Period: "Nov 2023 - June 2026",
                Bullets: [
                    "Decoupled legacy B2C booking platforms into self-contained, themeable, configurable WordPress plugins for the 2024 web rebrand launch",
                    "Owned post-launch development of platforms driving €300k monthly estravel.ee online-only sales",
                    "Led a company-wide (EE, LV, LT) Thunderbird to Gmail migration by developing a Gmail extension",
                    "Built Dubai evacuation registration for the Foreign Ministry in half a day, evacuating 435 in 72 hours",
                ],
                Technologies: "React, Vue, WordPress, PHP, MySQL, Python, Tailwind",
                Link: {
                    Src: "https://oskar-anderson.com/posts/estravel",
                    Text: "[read more]"
                }
            },
            {
                Title: "Fullstack developer intern",
                Company: "TalTech",
                Period: "June 2023 - Aug 2023",
                Bullets: [
                    "Improved a programming assignment Moodle plugin used by 1000 students each semester",
                    "Worked in a 5-developer agile scrum team with sprints, retros and merge reviews",
                ],
                Technologies: "Vue, PHP, Laravel, REST, MariaDB",
                Link: {
                    Src: "https://oskar-anderson.com/posts/charon",
                    Text: "[read more]"
                }
            }
        ],
    },
    PersonalProjectsSection: {
        Heading: {
            Title: "Personal Projects"
        },
        Content: [
            {
                ProjectName: "HedgehogDBD",
                Title: "Bachelor thesis",
                Period: "2023",
                Text: "Developed an open source database modeling ERD tool using TypeScript and React. Adopted in Priit Raspel's TalTech ICA0005 course as replacement to QSEE as it improves diagram creation workflow speed by 45%. Added functionality for creation and execution of user generated scripts.",
                Link: {
                    Src: "https://oskar-anderson.com/posts/HedgehogDBD",
                    Text: "[read more]"
                }
            },
            {
                ProjectName: "Maanteeamet Timescanner",
                Title: "",
                Period: "2019",
                Text: "Automated Maanteeamet driving exam registration with Python and Selenium",
                Link: {
                    Src: "https://oskar-anderson.com/posts/maanteeamet-timescanner",
                    Text: "[read more]"
                }
            }
        ],
    },
    EducationSection: {
        Heading: {
            Title: "Education"
        },
        Content: [
            {
                DateFinished: "Jan 2023",
                Text: "Bachelor of IT Systems Development - TalTech",
            }
        ],
    },
}


interface SectionHeading {
    Title: string;
}

export interface Props {
    Name: string;
    Title: string;
    IntroText: string;
    SideInfo: {
        Svg: string;
        Text: string;
        Link: string | null;
    }[];
    CategorizedListSections: {
        Heading: SectionHeading;
        Content: {
            CategoryName: string;
            List: string[];
        }[];
    };
    WorkSection: {
        Heading: SectionHeading;
        Content: {
            Title: string;
            Company: string;
            Period: string;
            Bullets: string[];
            Technologies: string;
            Link: {
                Src: string,
                Text: string
            }
        }[];
    };
    PersonalProjectsSection: {
        Heading: SectionHeading;
        Content:
        {
            ProjectName: string,
            Title: string,
            Period: string,
            Text: string,
            Link: {
                Src: string,
                Text: string
            }
        }[];
    };
    EducationSection: {
        Heading: SectionHeading;
        Content: {
            DateFinished: string;
            Text: string;
        }[];
    };
}

---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet" /> 
        <title>Karl Oskar Anderson Resume</title>
        <link rel="icon" type="image/x-icon" href="/static/img/favicon.ico" />
    </head>

<body class="A4" style="background: #e0e0e0;">
    <div class="hidden-print">
        <header class="bg-secondary">
            <div class="layout-container py-5 flex items-center justify-between">
                <div class="h1" style={{ marginBottom: 0, textAlign: "center", fontSize: "1.5em" }}>
                    <a style={{ textDecoration: "none" }} href="/">Karl Oskar</a>
                </div>
                <div class="text-white">
                    Press "Ctrl + P" and select "Save as PDF" to download
                </div>
            </div>
        </header>
    </div>
    <div class="resume" style={{ display: 'grid', lineHeight: "normal" }} id="root">
        <section class="sheet" style={{ display: "flex", background: "white" }}> <!-- sheet style is not applied to printed page so background: white is set manual -->
            <div style={{ overflow: "hidden" }}>
                <div style={{ display: "flex", margin: "10mm 10mm 1.2em 10mm" }}>
                    <div>
                        <header style={{ marginBottom: "20px" }}>
                            <h1
                                style={{
                                    fontSize: "32px",
                                    marginTop: "0px",
                                    marginBottom: "0px",
                                    fontWeight: 700
                                }}
                            >
                                {model.Name}
                            </h1>
                            <div style={{ fontSize: "13pt" }}>{model.Title}</div>
                        </header>
                        <div>{model.IntroText}</div>
                    </div>
                </div>
                <div
                    style={{
                        backgroundColor: "#f1f1f1",
                        justifyContent: "center",
                        padding: "0.8em 10mm",
                        lineHeight: "1.8em",
                        fontSize: "9pt",
                    }}
                    class="flex-gap"
                >
                    {
                        model.SideInfo.map((x) => {
                        return (
                            <div style={{ display: "flex" }}>
                                <div
                                    style={{
                                        display: "flex",
                                        alignItems: "center",
                                        marginRight: "0.8em",
                                    }}
                                >
                                    <i class={x.Svg}></i>
                                </div>
                                <div style={{ color: "#000"}}>
                                    {x.Link ? 
                                        <a href={x.Link}>
                                            {x.Text}
                                        </a> :
                                        x.Text
                                    }
                                </div>
                            </div>
                        );
                    })}
                </div>
                <div style={{ margin: "1.6em 10mm 10mm 10mm" }}>
                    <div class="o-section">
                        <h2 class="section-heading">
                            {model.WorkSection.Heading.Title}
                        </h2>
                        <hr />
                        <div>
                            {
                                model.WorkSection.Content.map(x => {
                                    return (
                                        <div style={{ position: "relative", marginBottom: "10px" }}>
                                            <div
                                                class="o-std-margin-bottom"
                                                style={{ display: "flex", justifyContent: "space-between" }}
                                            >
                                                <div style={{ fontWeight: "bold" }}>
                                                    {x.Title} - {x.Company}
                                                    <a style={{ fontWeight: "normal" }} href={x.Link.Src}>{x.Link.Text}</a>
                                                </div>
                                                <div style={{ alignItems: "center", display: "flex" }}>
                                                    {x.Period}
                                                </div>
                                            </div>
                                            <ul>
                                                {x.Bullets.map(bullet => <li>{bullet}</li>)}
                                                <li><span style={{ fontWeight: "bold" }}>Technologies:</span> {x.Technologies}</li>
                                            </ul>
                                        </div>
                                    );
                                })
                            }
                        </div>
                    </div>
                    <div class="o-section">
                        <h2 class="section-heading">
                            {model.PersonalProjectsSection.Heading.Title}
                        </h2>
                        <hr />
                        <div>
                            {model.PersonalProjectsSection.Content.map(x => {
                                return (
                                    <div style={{ position: "relative", marginBottom: "10px" }}>
                                        <div
                                            class="o-std-margin-bottom"
                                            style={{ display: "flex", justifyContent: "space-between" }}
                                        >
                                            <div style={{ fontWeight: "bold" }}>
                                                {x.ProjectName}{" "}
                                                {x.Title ? ` - ${x.Title}` : null}
                                                <a style={{ fontWeight: "normal" }} href={x.Link.Src}>{x.Link.Text}</a>
                                            </div>
                                            <div style={{ alignItems: "center", display: "flex" }}>
                                                {x.Period}
                                            </div>
                                        </div>
                                        <div>
                                            {x.Text}
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                    <div class="o-section">
                        <h2 class="section-heading">
                            {model.CategorizedListSections.Heading.Title}
                        </h2>
                        <hr />
                        <div>
                            {model.CategorizedListSections.Content.map(x => {
                                return (
                                    <div class="o-list-item-std-vertical-margin">
                                        <span style={{ fontWeight: "bold" }}>{x.CategoryName}:</span> {x.List.join(", ")}
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                    <div class="o-section">
                        <h2 class="section-heading">
                            {model.EducationSection.Heading.Title}
                        </h2>
                        <hr />
                        <div>
                            {model.EducationSection.Content.map(x => {
                                return (
                                    <div
                                        class="o-list-item-std-vertical-margin"
                                        style={{ position: "relative" }}
                                    >
                                        <div>
                                            {x.Text}
                                        </div>
                                        <div style={{ position: "absolute", right: 0, top: 0 }}>
                                            {x.DateFinished}
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</body>

<style>
    

@page { size: A4 }
:root {
    --primary-hl-color: rgb(255, 161, 54); 
}

h1, .h1, h2, .h2, h3, .h3, h4, .h4, h5, .h5 {
    font-family: "Arial";
}

a {
    color: var(--primary-hl-color);
    text-decoration: none;
}

@media print {
  .hidden-print {
    display: none !important;
  }

  /* orange prints as pale grey - keep links legible on paper */
  a {
    color: rgb(33, 37, 41);
  }
}

.resume {
    font-size: 11pt;
    font-family: Roboto, Verdana, Tahoma, sans-serif;
}

.o-list-item-std-vertical-margin + .o-list-item-std-vertical-margin {
    margin-top: 0.2em;
}

.o-std-margin-bottom {
    margin-bottom: 0.4em;
}

.o-section + .o-section {
    margin-top: 1.6em;
}

hr {
    margin: 0 0 0.6em 0;
    border: 0;
    border-top: 1px solid #ccc;
}

.section-heading {
    text-transform: uppercase;
    font-family: 'Arial';
    font-size: 12pt;
    font-weight: 600;
    margin-bottom: 0.4em;
}

.flex-gap {
    display: flex;
    flex-wrap: wrap;
}

.flex-gap > div {
    margin: 0 0.8em;
}

h2 {
    line-height: normal;
    font-size: 12pt;
    font-weight: 600;
}

ul {
    margin-bottom: 0;
    padding-left: 18px;
}

ul > li + li {
    margin-top: 0.2em;
}
</style>
